// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  name      String
  age       Int
  email     String   @unique
  password  String   
  role      String     @default("USER")
  user_posts UserPost[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model UserPost {
  id       Int  @id @default(autoincrement())
  title String
  author_id   Int
  user     User @relation(fields: [author_id], references: [id])

  @@map("user_posts") // Maps the model to the physical 'user_posts' table
}